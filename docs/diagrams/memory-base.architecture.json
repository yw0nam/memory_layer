  "cards": [
    {
      "dot": "cyan",
      "title": "One backend",
      "items": [
        "Every consumer reaches stored chunks through REST API :8010, never the database directly",
        "The MCP server forwards 10 tools to REST and holds no logic of its own",
        "The API key decides namespace scope and document · repo ownership"
      ]
    },
    {
      "dot": "emerald",
      "title": "Writes and indexing",
      "items": [
        "Document uploads and repo registrations answer 202 and land in the durable jobs table",
        "Two document workers dispatch fairly across API keys and serialize jobs for one document",
        "The code indexer indexes per file, incrementally, against the CocoIndex ledger"
      ]
    },
    {
      "dot": "rose",
      "title": "Split read privilege",
      "items": [
        "Search reads memory_chunks and code_chunks only; doc_rows never appears in results",
        "Table SQL runs as a role holding SELECT on doc_rows alone, inside a read-only transaction",
        "The vLLM embedding, rerank, and LLM endpoints are shared by indexing and search"
      ]
    }
  ]
